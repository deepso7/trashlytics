{
  "name": "trashlytics",
  "type": "module",
  "version": "0.3.0",
  "description": "A lightweight event tracking library",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./effect": {
      "import": {
        "types": "./dist/effect.d.ts",
        "default": "./dist/effect.js"
      },
      "require": {
        "types": "./dist/effect.d.cts",
        "default": "./dist/effect.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rolldown -c && tsc -p tsconfig.build.json && cp dist/index.d.ts dist/index.d.cts && cp dist/effect.d.ts dist/effect.d.cts",
    "test": "vitest",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "effect-language-service patch",
    "prepublishOnly": "pnpm run build",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm run build && changeset publish"
  },
  "keywords": [
    "analytics",
    "tracking",
    "events",
    "telemetry"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/deepso7/trashlytics"
  },
  "packageManager": "pnpm@10.26.2",
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@changesets/cli": "2.31.0",
    "@effect/language-service": "0.85.1",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/node": "25.6.0",
    "effect": "4.0.0-beta.60",
    "rolldown": "1.0.0-rc.18",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "ultracite": "7.6.3",
    "vitest": "4.1.5"
  },
  "peerDependencies": {
    "effect": "4.0.0-beta.60"
  }
}
