{
  "name": "trashlytics",
  "version": "0.6.0",
  "description": "A lightweight event tracking library",
  "keywords": [
    "analytics",
    "tracking",
    "events",
    "telemetry"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepso7/trashlytics.git"
  },
  "license": "MIT",
  "author": "deepso7 (https://github.com/deepso7)",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./effect": {
      "import": {
        "types": "./dist/effect.d.mts",
        "default": "./dist/effect.mjs"
      },
      "require": {
        "types": "./dist/effect.d.cts",
        "default": "./dist/effect.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "changeset": "changeset",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "effect-tsgo patch",
    "prepublishOnly": "pnpm run build",
    "publint": "publint",
    "release": "pnpm run build && changeset publish",
    "test": "vitest",
    "test:types": "attw --pack --profile node16",
    "version": "changeset version"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "3.0.3",
    "@effect/tsgo": "0.48.0",
    "@effect/vitest": "4.0.0",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/node": "26.6.4",
    "effect": "4.0.0",
    "publint": "0.3.25",
    "tsdown": "0.23.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "ultracite": "7.12.2",
    "vitest": "5.0.3"
  },
  "peerDependencies": {
    "effect": ">=4.0.0-rc.113 <5"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=20"
  }
}
