{
  "name": "trashlytics",
  "version": "0.5.0",
  "description": "A lightweight event tracking library",
  "keywords": [
    "analytics",
    "tracking",
    "events",
    "telemetry"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/deepso7/trashlytics"
  },
  "license": "MIT",
  "author": "",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./effect": {
      "import": {
        "types": "./dist/effect.d.mts",
        "default": "./dist/effect.mjs"
      },
      "require": {
        "types": "./dist/effect.d.cts",
        "default": "./dist/effect.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "changeset": "changeset",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "effect-tsgo patch",
    "prepublishOnly": "pnpm run build",
    "release": "pnpm run build && changeset publish",
    "test": "vitest",
    "version": "changeset version"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@changesets/cli": "3.0.2",
    "@effect/tsgo": "0.45.0",
    "@effect/vitest": "4.0.0-rc.113",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/node": "26.5.1",
    "effect": "4.0.0-rc.113",
    "tsdown": "0.23.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "ultracite": "7.11.1",
    "vitest": "5.0.0"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.113"
  },
  "packageManager": "pnpm@12.3.4"
}
